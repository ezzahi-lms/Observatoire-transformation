# ── Secrets & configuration locale ──────────────────────────────────────────
.env
# config/users.yaml est versionné (mots de passe bcrypt hashés — pas en clair)

# ── Rapports générés (trop lourds pour git) ───────────────────────────────────
reports/
*.docx
*.pdf
*.html
# Exception : le template HTML (pas un rapport généré)
!templates/*.html

# ── Fichiers tmp analyse (reprise après interruption réseau) ─────────────────
.tmp_*.json

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
streamlit_startup*.log

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# ── Streamlit cache ───────────────────────────────────────────────────────────
.streamlit/

# ── Claude (fichiers locaux de l'IDE) ────────────────────────────────────────
.claude/

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
