# Copiez ce fichier en .env et remplissez les valeurs

# ── Provider actif (anthropic | gemini) ──────────────────────────────────────
# LLM_PROVIDER=gemini

# ── Clé API Anthropic (console.anthropic.com) ────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# Modèle Claude (optionnel — sinon lu depuis settings.yaml)
# CLAUDE_MODEL=claude-sonnet-4-6

# ── Clé API Google Gemini (aistudio.google.com/app/apikey) ──────────────────
GEMINI_API_KEY=AIza...

# ── Clé API Groq (console.groq.com — free tier généreux, llama-3.3-70b) ─────
GROQ_API_KEY=gsk_...

# Modèle Gemini (optionnel — sinon lu depuis settings.yaml)
# GEMINI_MODEL=gemini-1.5-flash

# ── Token ngrok pour l'accès distant (dashboard.ngrok.com > Your Authtoken) ─
NGROK_AUTHTOKEN=your_ngrok_token_here
